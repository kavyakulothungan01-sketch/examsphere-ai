# ── Production Environment Variables (for Render.com) ────────────────────────
# Copy this to your Render.com service environment settings.
# NEVER commit real secrets to Git.

# Server port (Render sets this automatically; keep as 10000)
PORT=10000

# NODE_ENV must be "production" to enable production guards
NODE_ENV=production

# ── MongoDB Atlas (REQUIRED for production) ────────────────────────────────
# Create a free cluster at https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/examsphere-ai?retryWrites=true&w=majority

# IMPORTANT: Must be "false" in production. "true" = in-memory = data lost on restart!
USE_IN_MEMORY_DB=false

# ── JWT ────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_64_CHAR_HEX_SECRET

# ── Frontend URL (your Vercel deployment) ──────────────────────────────────
FRONTEND_URL=https://examsphere-kohl.vercel.app
CLIENT_URL=https://examsphere-kohl.vercel.app

# ── Email / SMTP (optional) ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
